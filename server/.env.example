NODE_ENV=development
PORT=5000

# postgres://<user>:<password>@<host>:<port>/<database-name>
DATABASE_URL=postgres://postgres:password@localhost:5432/orthopedic_rajamundry_dev

CORS_ORIGIN=http://localhost:5173

# Minimum 32 characters
JWT_SECRET=replace_this_with_a_secure_random_string_at_least_32_chars_long
